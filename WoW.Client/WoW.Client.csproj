    <ProjectReference Include="..\Lib\Nez-MG38\Nez.Portable\Nez.MG38.csproj" />
    <ProjectReference Include="..\WoW.Framework\WoW.Framework.csproj" />
    <ProjectReference Include="..\WoW.Network\WoW.Network.csproj" />
  </ItemGroup>
  <ItemGroup>
