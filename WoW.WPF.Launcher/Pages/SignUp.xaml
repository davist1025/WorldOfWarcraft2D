<Page x:Class="WoW.WPF.Launcher.Pages.SignUp"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WoW.WPF.Launcher.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SignIn">
    <Page.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#3a6baa"/>
        </Style>
    </Page.Resources>
    <Grid>
        <TextBlock Text="Note: Account management will be available at a later date." FontStyle="Italic" HorizontalAlignment="Center" Margin="0 50 0 0"/>

        <Border Grid.Column="1" CornerRadius="6" Margin="70" Height="110" Width="250">
            <Border.Background>
                <SolidColorBrush Color="#333333" />
            </Border.Background>
            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel HorizontalAlignment="Left">
                    <TextBlock Margin="10 15 15 0" Grid.Column="0" Text="Account Name"/>
                    <TextBlock Margin="10 15 15 0" Grid.Column="0" Text="Password"/>
                    
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBox x:Name="textBoxUsername"  Width="125" Margin="10 15 10 0"/>
                    <TextBox x:Name="textBoxPassword" Width="125" Margin="10 15 10 0"/>
                    <Button x:Name="btnRegister" Content="Sign Up" Width="75" Height="20" Margin="0 10 10 0" HorizontalAlignment="Right" Click="OnRegisterClicked"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
